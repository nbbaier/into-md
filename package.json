{
  "name": "into-md",
  "version": "1.0.1",
  "private": false,
  "description": "CLI to fetch clean urls as clean markdown for LLMs",
  "keywords": [
    "markdown",
    "html-to-markdown",
    "url-to-markdown",
    "llm",
    "readability",
    "scraper",
    "cli",
    "playwright"
  ],
  "homepage": "https://github.com/nbbaier/into-md#readme",
  "bugs": {
    "url": "https://github.com/nbbaier/into-md/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbbaier/into-md.git"
  },
  "license": "MIT",
  "author": "Nico Baier <nico.baier@gmail.com> (https://github.com/nbbaier)",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "into-md": "dist/index.mjs"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "check": "ultracite check",
    "deploy": "alchemy deploy --stage prod",
    "destroy": "alchemy destroy",
    "dev": "alchemy dev --stage dev",
    "fix": "ultracite fix",
    "release:major": "npm version major -m 'v%s' && bun run build",
    "release:minor": "npm version minor -m 'v%s' && bun run build",
    "release:patch": "npm version patch -m 'v%s' && bun run build",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@types/turndown": "^5.0.6",
    "alchemy": "^0.93.7",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "hono": "^4.13.7",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.0",
    "tsdown": "^0.23.0",
    "ultracite": "7.11.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
